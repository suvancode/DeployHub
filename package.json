{
  "name": "deployhub",
  "version": "1.1.0",
  "description": "Secure Windows desktop application for automating Git, GitHub and Vercel setup with manual push",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "author": "DeployHub",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build-preload.js && vite",
    "build:preload": "node scripts/build-preload.js",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "build": "npm run build:renderer && npm run build:preload && npm run build:electron",
    "electron:dev": "npm run build:preload && concurrently -k \"vite\" \"wait-on tcp:5173 && npm run build:electron && electron .\"",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  }
}
